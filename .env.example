# ---------------------------------------------------------------------------
# ZIBA VENEZUELA — variables de entorno
# Copia este archivo como `.env` y completa los valores.
# Todo lo que empieza por VITE_ queda expuesto en el bundle del navegador:
# NO pongas aquí secretos de servidor (API secret de Cloudinary, claves de admin).
# ---------------------------------------------------------------------------

# --- Firebase (Consola Firebase > Configuración del proyecto > Tus apps) ---
VITE_FIREBASE_API_KEY=AIzaSyDe3IKcZS0fFm0ttM1Zo1ZlR2vhpNzGGCs
VITE_FIREBASE_AUTH_DOMAIN=zibavenezuela-fa1e3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zibavenezuela-fa1e3
VITE_FIREBASE_STORAGE_BUCKET=zibavenezuela-fa1e3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1051007117204
VITE_FIREBASE_APP_ID=1:1051007117204:web:37173534f0021f49da5181

# --- Cloudinary (Dashboard > Product Environment Credentials) ---
# Nombre del cloud, ej: "ziba-venezuela"
VITE_CLOUDINARY_CLOUD_NAME=
# Upload preset SIN FIRMAR (Settings > Upload > Upload presets > Signing Mode: Unsigned)
# Se usa desde el panel de administración para subir fotos de producto.
VITE_CLOUDINARY_UPLOAD_PRESET=ziba_unsigned
# Carpeta destino dentro de Cloudinary
VITE_CLOUDINARY_FOLDER=ziba

# --- Tienda ---
VITE_STORE_WHATSAPP=584120000000
VITE_STORE_EMAIL=hola@zibavenezuela.com
VITE_STORE_INSTAGRAM=zibavenezuela

# --- Semilla de datos (solo para `npm run seed`, NO se sube al bundle) ---
# Usuario admin ya creado en Firebase Authentication (Email/Password).
# En el formulario de acceso se escribe sólo "adminziba"; el correo completo
# es lo que espera Firebase.
SEED_ADMIN_EMAIL=adminziba@zibavenezuela.com
SEED_ADMIN_PASSWORD=
