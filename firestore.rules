rules_version = '2';

// ---------------------------------------------------------------------------
// ZIBA VENEZUELA — Reglas de seguridad de Firestore
//
// La tienda no usa Firebase Authentication: el acceso al panel se resuelve en
// el navegador. Firestore, por tanto, no recibe ningún `request.auth` y NO
// PUEDE distinguir al administrador de un visitante cualquiera.
//
// Consecuencia: la escritura del catálogo queda abierta. Quien conozca el id
// del proyecto puede crear, modificar o borrar productos, categorías y
// pedidos. Se limita lo que se puede (forma de los datos, tamaño), pero no
// hay forma de restringirlo por identidad sin autenticación.
//
// Publicar:  firebase deploy --only firestore:rules
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Catálogo ---------------------------------------------------------

    match /products/{productId} {
      allow read: if true;

      // Se valida la forma del documento para evitar basura accidental
      allow create, update: if request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() < 200
                            && request.resource.data.price is number
                            && request.resource.data.price >= 0;

      allow delete: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;

      allow create, update: if request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() < 120;

      allow delete: if true;
    }

    // --- Pedidos ----------------------------------------------------------

    match /orders/{orderId} {
      // Se lee con el id del documento, que es aleatorio y no se lista
      allow read: if true;

      // Todo pedido nace pendiente y con importes coherentes
      allow create: if request.resource.data.status == 'pendiente'
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 100;

      // El panel sólo mueve el estado del pedido
      allow update: if request.resource.data.diff(resource.data)
                      .affectedKeys()
                      .hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // --- Newsletter -------------------------------------------------------

    match /newsletter/{email} {
      allow create, update: if request.resource.data.email is string
                            && request.resource.data.email.size() < 200;
      allow read: if true;
      allow delete: if false;
    }

    // Todo lo que no esté declarado arriba queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
